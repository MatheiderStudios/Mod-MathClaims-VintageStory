<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>bin/$(Configuration)/Mods/mathclaims/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">/run/media/matheider/armazem/Servers/Vintage_Story/1.22.7</VintageStoryPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryPath)/Mods/VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="protobuf-net"><HintPath>$(VintageStoryPath)/Lib/protobuf-net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VintageStoryPath)/Lib/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Content Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PackageMathClaims" AfterTargets="Build">
    <Exec WorkingDirectory="$(OutputPath)" Command="bsdtar -a -cf ../mathclaims_1.0.1.zip MathClaims.dll MathClaims.deps.json MathClaims.pdb modinfo.json assets" />
  </Target>
</Project>
